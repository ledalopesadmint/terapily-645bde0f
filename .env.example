# =============================================================================
# Terapily — Variáveis de ambiente (template)
# =============================================================================
# Copie este arquivo para `.env` e preencha os valores reais.
# NUNCA commite o `.env` (já está no .gitignore gerenciado pelo Lovable).
#
# Em produção (Lovable Cloud), todas estas variáveis são injetadas
# automaticamente — você não precisa configurá-las manualmente.
# Este arquivo serve para:
#   1. Onboarding de devs locais (clone do GitHub fora do Lovable)
#   2. Documentar quais variáveis o app espera encontrar
# =============================================================================


# -----------------------------------------------------------------------------
# CLIENT-SIDE (seguras para enviar ao browser)
# -----------------------------------------------------------------------------
# Estas variáveis são publicadas no bundle do client. NÃO coloque aqui nada
# que precise ficar privado. A publishable/anon key do Supabase foi desenhada
# para isso — toda a segurança está nas RLS policies do banco.

VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR-PUBLISHABLE-ANON-KEY"
VITE_SUPABASE_PROJECT_ID="YOUR-PROJECT-REF"


# -----------------------------------------------------------------------------
# SERVER-SIDE (NUNCA expor ao client)
# -----------------------------------------------------------------------------
# Estas variáveis são lidas APENAS por server functions / edge functions
# (arquivos `*.server.ts`). Bypassam RLS — qualquer vazamento compromete
# todos os dados. No Lovable Cloud já são gerenciadas como Secrets.

SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"

# SERVICE_ROLE_KEY: chave administrativa, bypassa RLS.
# - NUNCA importar em código do client (`src/components/**`, `src/routes/**`
#   sem sufixo `.server`).
# - Hoje é usada por `src/integrations/supabase/client.server.ts`
#   e pelo helper de auditoria `src/features/audit/audit.server.ts`.
# - Em S2+ será usada também por edge functions (billing webhooks etc.).
# SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-KEY"


# -----------------------------------------------------------------------------
# LOVABLE AI GATEWAY (futuro — Semana 4+)
# -----------------------------------------------------------------------------
# Gerenciada automaticamente pelo Lovable Cloud. Não definir manualmente.
# LOVABLE_API_KEY="managed-by-lovable-cloud"
