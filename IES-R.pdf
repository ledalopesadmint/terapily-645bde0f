                    <td><input type="radio" onclick="notRed(this)" name="IESR_q18" class="P_3 hyperarousal" value="3" id="IESR_q18_3"></td>
                    <td><input type="radio" onclick="notRed(this)" name="IESR_q18" class="P_4 hyperarousal" value="4" id="IESR_q18_4"></td>
                </tr>
                <tr>
                    <td class="ltalign red_check" id="IESR_text_q19">19. Reminders of it caused me to have physical reactions, such as sweating, trouble breathing, nausea, or a pounding heart</td>
                    <td><input type="radio" onclick="notRed(this)" name="IESR_q19" value="0" id="IESR_q19_0"></td>
                    <td><input type="radio" onclick="notRed(this)" name="IESR_q19" class="P_1 hyperarousal" value="1" id="IESR_q19_1"></td>
