                </tr>
                <tr>
                    <td class="ltalign red_check" id="IESR_text_q20">20. I had dreams about it</td>
                    <td><input type="radio" onclick="notRed(this)" name="IESR_q20" value="0" id="IESR_q20_0"></td>
                    <td><input type="radio" onclick="notRed(this)" name="IESR_q20" class="P_1 intrusion" value="1" id="IESR_q20_1"></td>
